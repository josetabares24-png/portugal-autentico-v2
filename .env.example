# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (Brevo/Sendinblue)
BREVO_API_KEY=xkeysib-xxx
BREVO_LIST_ID=5

# Stripe Webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Site URL (cambiar en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# GuruWalk — afiliación para /free-tours-lisboa
#
# Método principal: un único identificador de referido. Se añade a las URLs
# públicas de GuruWalk como ref=<ID>, junto con pro=true (solo tours PRO) y
# las UTM del sitio. Las URLs de cada categoría ya están en el código
# (src/data/affiliate-links.ts), así que con esta variable basta.
#
# No es un secreto: el enlace final es visible en el href renderizado, como
# cualquier enlace de afiliado. Está aquí solo para no fijarlo en el código.
#
# Mientras no esté definida, los CTA de reserva se renderizan inertes.
GURUWALK_AFFILIATE_REF=

# Compatibilidad temporal con la configuración anterior (una URL afiliada
# completa para todo el destino). Solo se usa si GURUWALK_AFFILIATE_REF no
# está definida. Preferir siempre GURUWALK_AFFILIATE_REF.
GURUWALK_AFFILIATE_URL_LISBOA=
